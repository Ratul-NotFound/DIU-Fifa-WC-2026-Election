rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if voter's email ends with the required DIU domain
    function isDIUEmail() {
      return request.auth.token.email.matches('(?i).*@diu\\.edu\\.bd$');
    }

    // Helper to check if the user profile document exists before querying properties
    function existsUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && existsUserData() && getUserData().role in ['admin', 'superAdmin'];
    }

    function isSuperAdmin() {
      return isSignedIn() && existsUserData() && getUserData().role == 'superAdmin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── USERS ──────────────────────────────────────────────
    match /users/{uid} {
      // Any signed-in user can read their own profile, admins can read all
      allow read: if isOwner(uid) || isAdmin();
      // Create own profile on first login
      allow create: if isOwner(uid) && isDIUEmail();
      // Update own profile (except role, unless they are the hardcoded super admin); only superAdmin can update others' roles
      allow update: if (isOwner(uid) && (
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
                      request.auth.token.email == 'ratul23105101298@diu.edu.bd'
                    ))
                    || isSuperAdmin()
                    || (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isSuperAdmin();
    }

    // ── TEAMS ──────────────────────────────────────────────
    match /teams/{teamId} {
      allow read: if true; // Publicly readable for landing page
      allow write: if isAdmin();
    }

    // ── POSITIONS ──────────────────────────────────────────
    match /positions/{posId} {
      allow read: if true; // Publicly readable for results
      allow write: if isAdmin();
    }

    // ── CANDIDATES ─────────────────────────────────────────
    match /candidates/{candId} {
      // Approved candidates visible to all
      allow read: if resource.data.approved == true || isAdmin();
      // Admin can create or delete candidates
      allow create, delete: if isAdmin();
      // Users can update candidate's votesReceived (only increment by 1)
      allow update: if isAdmin() || (
        isSignedIn() && isDIUEmail() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votesReceived']) &&
        request.resource.data.votesReceived == resource.data.votesReceived + 1
      );
    }

    // ── VOTES ──────────────────────────────────────────────
    match /votes/{voteId} {
      // Votes are write-only via transaction (no direct client reads of others' votes)
      allow create: if isSignedIn() && isDIUEmail()
                    && request.resource.data.voterUid == request.auth.uid;
      // Users can read their own votes; only admin can read all
      allow read: if isAdmin() || (isSignedIn() && resource.data.voterUid == request.auth.uid);
      // No updates or deletes on votes
      allow update, delete: if false;
    }

    // ── RESULTS (pre-aggregated) ────────────────────────────
    match /results/{resultId} {
      // All users can read results
      allow read: if true;
      // Results written only via server transaction
      allow write: if isSignedIn() && isDIUEmail();
    }

    // ── ELECTION SETTINGS ──────────────────────────────────
    match /electionSettings/{docId} {
      allow read: if true; // Public
      allow write: if isAdmin();
    }

    // ── PREASSIGNED ROLES ──────────────────────────────────
    match /preassignedRoles/{email} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isAdmin();
    }

    // ── AUDIT LOGS ─────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Immutable logs
    }
  }
}
